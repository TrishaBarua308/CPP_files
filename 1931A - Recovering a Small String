#include<bits/stdc++.h>
using namespace std;
int main()
{
    int t;  cin>>t;
    while(t--)
    {
        int n; cin>>n;
        int a,b,c; 
        for(int i=1; i<=26; i++)
        {
            for(int j=1; j<=26; j++)
            {
                for(int k=1; k<=26; k++)
                {
                    if((i+j+k)==n)
                    {
                        a=k; b=j; c=i;
                        break;
                        //cout<<a<<" "<<b<<" "<<c<<endl;
                    }
                }
            }
        }
        
        cout<<char(a+96)<<char(b+96)<<char(c+96)<<endl;
    }
}


