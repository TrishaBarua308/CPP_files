#include <bits/stdc++.h>
using namespace std;
     
int main() {
    int n;  cin>>n;
    int a[n];
    for(int i=0; i<n; i++) cin>>a[i];
    int sw=0;
    for(int i=0; i<n-1; i++)
    {
        while(a[i]!=(i+1))
        {
            swap(a[i], a[a[i]-1]);
            sw++;
        }
    } 
    cout<<sw;

    return 0;
}
