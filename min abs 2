#include<bits/stdc++.h>
#define ll long long
#define optimize ios::sync_with_stdio(0); cin.tie(0); cout.tie(0);
using namespace std;
int main()
{
    optimize;
    ll d;  cin>>d;
    ll ans = d;

    for(ll x=0; x*x<=d; x++)
    {
        ll y = sqrt(d-x*x);
        ans = min(ans, abs(x*x + y*y-d));
        ans = min(ans, abs(x*x + (y+1)*(y+1)-d));
    }
    cout<<ans;
    return 0;
}
