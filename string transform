#include <bits/stdc++.h>
using namespace std;
     
int main() {
    /**
    * Write your C++ code from here
    */
    string s; cin>>s;
    int n = s.length();
    for(int i=2; i<n; i+=3)
    {
        if(s[i]>='a' && s[i]<='z')
        {
            s[i] = toupper(s[i]);
        }
    }
    cout<<s;

    return 0;
}
