#include <bits/stdc++.h>
#define ll long long
using namespace std;
     
int main() {
    ll n;  cin>>n;
    vector<ll> m(n);  for(int i=0; i<n; i++) cin>>m[i];
    ll p;  cin>>p; 

    ll index=-1;
    for(int i=0; i<n; i++)
    {
        if(m[i]==p)
        {
            index = i;
            break;
        }
    }
    if(index>=0) cout<<index;
    else cout<<"Element not found\n";    

    return 0;
}
