#include <bits/stdc++.h>
#define ll long long
using namespace std;

int main() {
	ll n;
	cin>>n;
	if(n<=1) cout<<n<<" is not a prime number.\n";
	else
	{
	    bool prime = true;
	    for(int i = 2; i<=sqrt(n); i++)
	    {
	        if(n%i==0)
	        {
	            prime = false;
	            break;
	        }
	    }
	    
	    if(prime) cout<<n<<" is a prime number.\n";
	    else  cout<<n<<" is not a prime number.\n";
	}

	return 0;
}
