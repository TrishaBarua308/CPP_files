#include <bits/stdc++.h>
using namespace std;
     
int main() {
    int n,k;  cin>>n>>k;
    int a[n];
    for(int i=0; i<n; i++) cin>>a[i];
    while(k--)
    {
        int ans=-1;
        int p;  cin>>p;
        for(int i=0; i<n; i++)
        {
            if(a[i]>p)
            {
                ans = a[i];
                break;
            }
        }
        cout<<ans<<endl;
    }
    return 0;
}
