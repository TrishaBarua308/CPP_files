#include <bits/stdc++.h>
using namespace std;
     
int main() {
    int n; cin>>n;
    vector<int> v;
    while(n!=0)
    {
        int r = n%10; 
        v.push_back(r);
        n/=10;
    }
    vector<string> s = {"zero","one","two","three","four","five","six","seven","eight","nine"};
    reverse(v.begin(), v.end());
    for(auto i : v) cout<<s[i]<<" ";
       

    return 0;
}
