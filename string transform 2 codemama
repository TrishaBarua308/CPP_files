#include <bits/stdc++.h>
using namespace std;
     
int main() {
    string s;  cin>>s;
    int n=s.length();
    
    if(n%2==0)
    {
        for(int i=0; i<n-3; i+=2)
        {
            cout<<s[i]<<s[i+1]<<'x';
        }
        cout<<s[n-2]<<s[n-1];
    }
    else if(n%2==1) // o
    {
        for(int i=0; i<n-2; i+=2)
        {
            cout<<s[i]<<s[i+1]<<'x';
        }
        cout<<s[n-1];
    }

    return 0;
}
