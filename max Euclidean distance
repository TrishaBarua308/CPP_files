#include <bits/stdc++.h>
using namespace std;
     
int main() {
    int n;  cin>>n;
    int a[1000][2];
    for(int i=0; i<n; i++)
    {
        cin>>a[i][0]>>a[i][1];
    }
    int max = -9999;

    for(int i=0; i<n; i++)
    {
        for(int j=i+1; j<n; j++)
        {
            int p = pow( abs( a[i][0]-a[j][0] ),2 );
            int f = pow( abs( a[i][1]-a[j][1] ),2 );
            int t = p+f;
            if(t>max)
            {
                max=t;
            }

        }
    }
    
    cout<<max;

    return 0;
}
