#include <bits/stdc++.h>

using namespace std;

int main()
{
    int t;  cin>>t;
    while(t--)
    {
        int a[7];
        for(int i=0; i<7; i++) cin>>a[i];
        int s=0,r=0;
        for(int i=0; i<7; i++)
        {
            if(a[i]==1) s++;
            else r++;
        }
        if(s>r) cout<<"YES\n";
        else cout<<"NO\n";
    }
    return 0;
}
