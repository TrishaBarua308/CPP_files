#include <bits/stdc++.h>
using namespace std;

int main() 
{
	// your code goes here
	int t;   cin>>t;
	
	while(t--)
	{
	    int n;   cin>>n;
	    int a[n];   
	    for(int i=0; i<n; i++)  cin>>a[i];
	    int index;
	    
	    for(int i=n-1; i>=0; i--)
	    {
	        if( a[i]!= 0 )
	        {
	            index = i; 
	            break;
	        }
	    }
	    
	    cout<<index<<endl;
	}
	
	return 0;

}
