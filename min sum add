#include <bits/stdc++.h>
#define ll long long
using namespace std;
     
int main() {
    ll n;  cin>>n;
    vector<ll> v(n);
    for(ll i=0; i<n; i++) cin>>v[i];
    sort(v.begin(), v.end());
    ll ans=0;
    for(ll i=0; i<n/2; i++)
        {
            ans += v[i]*v[n-i-1];
        }
    cout<<ans<<endl;


    return 0;
}
